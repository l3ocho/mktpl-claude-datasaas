{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "design-contract.schema.json",
  "title": "DesignContract",
  "description": "Per-project surface hierarchy contract for dmc-design consistency",
  "type": "object",
  "required": ["interaction", "density", "meta"],
  "properties": {
    "schemes": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "light": { "$ref": "#/definitions/scheme" },
        "dark": { "$ref": "#/definitions/scheme" }
      },
      "additionalProperties": false
    },
    "component_locks": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/component_lock" }
    },
    "interaction": {
      "type": "object",
      "required": ["hover_delta", "focus_ring", "disabled_opacity", "error_token"],
      "properties": {
        "hover_delta": { "type": "integer" },
        "focus_ring": {
          "type": "object",
          "required": ["size", "color_token"],
          "properties": {
            "size": { "type": "integer" },
            "color_token": { "type": "string" }
          }
        },
        "disabled_opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "error_token": { "type": "string" }
      }
    },
    "density": { "type": "string", "enum": ["compact", "comfortable"] },
    "meta": {
      "type": "object",
      "required": ["version", "created_at", "updated_at"],
      "properties": {
        "version": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "definitions": {
    "scheme": {
      "type": "object",
      "required": ["surfaces"],
      "properties": {
        "surfaces": {
          "type": "object",
          "required": ["base", "raised", "overlay", "nested_in_overlay"],
          "properties": {
            "base": { "$ref": "#/definitions/surface" },
            "raised": { "$ref": "#/definitions/surface" },
            "overlay": { "$ref": "#/definitions/surface" },
            "nested_in_overlay": { "$ref": "#/definitions/surface" }
          }
        }
      }
    },
    "surface": {
      "type": "object",
      "required": ["bg"],
      "properties": {
        "bg": { "type": "string" },
        "border": { "type": ["string", "null"] },
        "variant": { "type": ["string", "null"] }
      }
    },
    "component_lock": {
      "type": "object",
      "required": ["locked_at", "reference_file", "reference_line", "spec"],
      "properties": {
        "locked_at": { "type": "string", "format": "date-time" },
        "reference_file": { "type": "string" },
        "reference_line": { "type": "integer" },
        "spec": { "type": "object" }
      }
    }
  }
}
