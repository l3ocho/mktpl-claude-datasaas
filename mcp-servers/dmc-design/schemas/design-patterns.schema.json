{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "design-patterns.schema.json",
  "title": "DesignPatterns",
  "type": "object",
  "required": ["meta", "patterns"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["version", "updated_at"],
      "properties": {
        "version": { "type": "string" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "scheme_mode": { "type": "string", "enum": ["single", "dual"] },
    "css_entry_points": { "type": "array", "items": { "type": "string" } },
    "css_tokens": {
      "type": "object",
      "properties": {
        "extracted_at": { "type": "string", "format": "date-time" },
        "custom_properties": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "light": { "type": "string" },
              "dark": { "type": "string" }
            }
          }
        }
      }
    },
    "patterns": {
      "type": "array",
      "items": { "$ref": "#/definitions/pattern" }
    }
  },
  "definitions": {
    "pattern": {
      "type": "object",
      "required": ["id", "rule", "category", "enforcement", "declared_at"],
      "properties": {
        "id": { "type": "string", "pattern": "^p[0-9]{3,}$" },
        "declared_by": { "type": "string" },
        "declared_at": { "type": "string", "format": "date-time" },
        "rule": { "type": "string", "minLength": 10 },
        "category": { "type": "string", "enum": ["layout", "css", "component", "naming"] },
        "enforcement": {
          "type": "object",
          "required": ["file_globs", "detect", "severity"],
          "properties": {
            "file_globs": { "type": "array", "items": { "type": "string" } },
            "detect": { "type": "string" },
            "severity": { "type": "string", "enum": ["fail", "warn"] }
          }
        },
        "source": { "type": "string", "enum": ["manual", "scan"] }
      }
    }
  }
}
